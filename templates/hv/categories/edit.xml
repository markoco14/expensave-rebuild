{% extends "hv/layout.xml" %}

{% block header %}
<text style="header-text">Edit {{ category.name }}</text>
{% endblock header %}

{% block content %}
<form id="category-form" style="container">

    {% include "hv/categories/_form-fields.xml" %}

    <view style="form-actions">

        <view style="form-actions__column form-actions__column--left">
            <view 
                style="btn btn-secondary form-action form-action--secondary"
                >
                <behavior trigger="press" action="reload" href="/hv/categories/{{ category.category_id }}"/>
                {% include "hv/svg/cancel.xml" %}
            </view>
        </view>

        <view style="form-actions__column form-actions__column--center">
            <view 
                verb="post"
                href="/hv/categories/{{ category.category_id }}/edit"
                target="form-fields"
                action="replace-inner"
                style="btn btn-primary form-action form-action--primary"
                >
                {% include "hv/svg/checkmark-primary.xml" %}
            </view>
        </view>



        <view style="form-actions__column form-actions__column--right">
            <view style="form-action form-action--delete">

                <behavior
                    xmlns:alert="https://hyperview.org/hyperview-alert"
                    trigger="press"
                    action="alert"
                    alert:title="Delete category"
                    alert:message="Are you sure you want to delete this category?"
                    >
                    <alert:option alert:label="Delete">
                        <behavior 
                            trigger="press"
                            action="append"
                            target="form-fields"
                            href="/hv/categories/{{ category.category_id }}/delete" 
                            verb="post"
                        />
                    </alert:option>
                    <alert:option alert:label="Cancel"/>

                </behavior>
                {% include "hv/svg/delete.xml" %}
            </view>
        </view>

    </view>
</form>
{% endblock content%}