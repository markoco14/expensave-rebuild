{% extends "hv/layout.xml" %}

{% block header %}
{% endblock header %}

{% block content %}
<view style="container column">
	<behavior trigger="on-event" event-name="category-added" action="reload" href="/hv/categories"/>
	<behavior trigger="on-event" event-name="category-deleted" action="reload" href="/hv/categories"/>

	<text style="heading text-dark text-center">{{ current_month.strftime("%B %Y") }}</text>

	<view style="card new-category">
		<behavior action="new" href="/hv/categories/new" />
		<text style="text-dark text-large text-center">+ Category</text>
	</view>

	{% for category in categories %}
	<view style="card">
		<behavior action="push" href="/hv/categories/{{ category.category_id }}"/>
		<text style="text-dark text-large text-center">{{ category.name }}</text>
	</view>
	{% endfor %}

</view>

{% endblock content %}
