{% extends "hv/layout.xml" %}

{% block header %}
<header style="header flex-header">
    <view style="header-placeholder" action="back">
        {% include "hv/svg/back.xml" %}
    </view>
    <text style="heading text-dark text-center">{{ bucket.name }}</text>
    <view style="header-placeholder" action="reload" href="/hv/top-up/{{ top_up.top_up_id }}/edit">
        {% include "hv/svg/edit.xml" %}
    </view>
</header>
{% endblock header %}

{% block content %}
<list style="container">
    <item style="card margin-bottom">
        <text style="text-dark text-large">Month: {{ top_up.month_start }}</text>
        <text style="text-dark text-large">Starting Amount: {{ top_up.start_amount }}</text>
        {# <text style="text-dark text-large">Amount Remaining: {{ top_up.end_amount if top_up.end_amount else 0 }}</text> #}
        {# <text style="text-dark text-large">Month: {{ top_up.month_start }}</text> #}
</text>
    </item>

    <item style="card margin-bottom">
        <text style="text-dark text-large">End of day stats</text>
        {% if bucket.is_daily %}
        <text style="text-dark text-large">Expected: {{ top_up.start_amount - amount_spent }} </text>
        {% endif %}
        <text style="text-dark text-large">Logged:</text>
        {# logged will need a request? Or I have to use a SUM query in the main endpoint? #}
        <text style="text-dark text-large">Actual: {{ top_up.end_amount if top_up.end_amount else 0 }}</text>
    </item>

    <item id="top-up-purchases">
        <behavior 
            href="/hv/buckets/{{ bucket.bucket_id }}?content=list" 
            trigger="load" 
            target="top-up-purchases" 
            action="replace" />
        <text style="card text-large text-dark">Loading...</text>
    </item>
    
</list>
{% endblock content%}