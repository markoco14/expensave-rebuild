{% extends "hv/layout.xml" %}

{% block header %}
<text style="header-text">{{ today_date.strftime("%B %d, %Y") }}</text>
    <view id="logout-btn" style="">
        <behavior 
        trigger="press" 
        target="logout-btn" 
        action="replace" 
        href="/hv/logout" />
        <text style="text-dark text-large text-center">
        {% include "hv/svg/logout.xml" %}
        </text>
</view>
{% endblock header%}

{% block content %}
<view style="container">
    <behavior trigger="on-event" event-name="purchase-added" action="reload" href="/hv/today"/>
    <behavior trigger="on-event" event-name="purchase-deleted" action="reload" href="/hv/today"/>
    <list 
        id="purchase-list" 
        trigger="refresh" 
        action="replace-inner" 
        target="purchase-list" 
        href="/hv/today?rows_only=true"
        >
        {% include "hv/_rows.xml"%}
    </list>
</view>
{% endblock content %}
