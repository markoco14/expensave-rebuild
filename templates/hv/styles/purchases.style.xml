{% set button_width = grid_col_width(request, columns=3, gap=8, padding=8) %}

<style 
    id="progress-track"
    backgroundColor="{{ red_500 }}"
    width="100%"
    height="32"
    borderRadius="4"
    display="flex"
    flexDirection="row"
    alignItems="center"
    marginBottom="24"
    />
    
<style 
    id="progress-bar"
    backgroundColor="{{ green_500 }}"
    height="100%"
    borderTopLeftRadius="4"
    borderBottomLeftRadius="4"
    width="{{ percent_remaining }}%"
    display="flex"
    flexDirection="row"
    justifyContent="flex-end"
    alignItems="center"
    paddingRight="4"
    marginRight="4"
    />

<style 
    id="remainder" 
    color="{{ gray_900 }}"
    marginBottom="16" 
    fontSize="18"
    />

<style id="bucket-bar"
    display="flex"
    flexDirection="row"
    gap="4"
    overflow="scroll"
    marginBottom="32"
    />

<style id="bucket-bar-item"
    backgroundColor="{{ green_200 }}"
    borderWidth="1"
    borderColor="{{ green_400 }}"
    paddingVertical="4"
    paddingHorizontal="16"
    borderRadius="8"
    />

<style
    id="list-item"
    display="flex"
    flexDirection="row"
    justifyContent="space-between"
    color="{{ gray_900 }}" 
    backgroundColor="{{ white }}"
    padding="16"
    borderColor="{{ gray_200 }}"
    borderBottomWidth="1"
    />

<style 
    id="list-item-text"
    color="{{ gray_900 }}"
    fontSize="16"
    />



{# keypad styles #}

<style id="keypad-display"
    backgroundColor="white"
    paddingVertical="8"
    paddingHorizontal="8"
    />

<style id="keypad-display-text"
    color="black"
    fontSize="24"
    textAlign="right"
    />

<style id="keypad-numbers"
    display="flex"
    flexDirection="row"
    flexWrap="wrap"
    gap="8"
    marginTop="8"
    />

<style id="keypad-button"
    width="{{ button_width }}"
    height="50"
    display="flex"
    alignItems="center"
    justifyContent="center"
    backgroundColor="white"
    borderRadius="4"
    borderWidth="1"
    borderColor="{{ gray_300 }}"
    >
    <modifier pressed="true">
        <style backgroundColor="{{ green_200 }}" />
    </modifier>
</style>

<style id="keypad-button-empty" 
    width="{{ button_width }}"
    height="50"
    />

<style id="keypad-button-text" 
    fontSize="24"
    color="black"
    />

<style id="purchase-fields"
    display="flex"
    flexDirection="column"
    gap="16"
    />

<style id="purchase-field"
    backgroundColor="white"
    borderWidth="1"
    borderColor="{{ gray_200 }}"
    borderRadius="8"
    padding="16"
    />

<style id="field-label"
    fontSize="18"
    color="{{ gray_600 }}"
    fontWeight="600"
    borderBottomWidth="1"
    borderColor="{{ gray_600 }}"
    marginBottom="8"
    />

<style id="field-detail"
    fontSize="24"
    color="{{ gray_900 }}"
    
    />