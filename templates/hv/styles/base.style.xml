<style id="body"
    flex="1"
    position="relative"
    />

<style id="header"
    flex="0"
    minWidth="100%"
    paddingHorizontal="8"
    display="flex"
    flexDirection="row"
    justifyContent="space-between"
    alignItems="center"
    />

<style id="main"
    flex="2"
    backgroundColor="{{ gray_50 }}"
    display="flex"
    flexDirection="column"
    />

<style id="container"
    padding="8"
    flexGrow="1"
    flexShrink="0"
    flexBasis="0"
    minHeight="100%"
    />

<style id="content"
    flex="1"
    display="flex"
    flexDirection="column"
    justifyContent="center"
    />
    
<style id="content--top"
    justifyContent="flex-start"
    />
    


<style id="bottom-nav"
    display="flex"
    flexDirection="row"
    height="56"
    backgroundColor="{{ white }}"
    />

<style id="tab-item"
    flex="1"
    {# width="25%" #}
    alignItems="center"
    justifyContent="center"
    paddingTop="8"
    paddingBottom="8"
>
    <modifier selected="true">
        <style backgroundColor="{{ gray_900 }}" color="{{ white }}"/>
    </modifier>
</style>

<style id="tab-label"
    color="{{ gray_900 }}"
    fontSize="18"
    textAlign="center"
    >
    <modifier selected="true">
        <style color="{{ white }}" />
    </modifier>
</style>


<style id="heading"
    fontSize="32"
    color="{{ gray_900 }}"
    textAlign="center"
    />

<style id="header-placeholder"
    width="40"
    height="40"
    display="flex"
    flexDirection="row"
    justifyContent="center"
    alignItems="center"
    borderRadius="100%"
    />

<style id="margin-bottom" marginBottom="16"/>

<style id="column"
    display="flex"
    flexDirection="column"
    gap="16"
    />

<style id="card"
    backgroundColor="{{ white }}"
    padding="16"
    borderRadius="8"
    />

<style id="btn" 
    padding="8"
    borderRadius="4"
    />

<style id="btn-primary" 
    backgroundColor="{{ green_500 }}"
    >
    <modifier pressed="true">
        <style backgroundColor="{{ green_600 }}"  />
    </modifier>
</style>

<style id="btn-primary-text"
    color="{{ green_800 }}"
    textAlign="center"
    fontSize="18"
    fontWeight="600"
    textTransform="uppercase"
>
    <modifier pressed="true">
        <style color="{{ white }}" />
    </modifier>
</stlye>

<style id="btn-secondary" 
    borderWidth="1"
    borderColor="{{ gray_600 }}"
    />

<style id="btn-tab" 
    borderWidth="1"
    borderColor="{{ gray_600 }}"
    {# width="25%" #}
/>

<style id="btn-delete" 
    backgroundColor="{{ red_500 }}"
    />

<style id="btn-gap"
    marginBottom="12"
    />

<style id="bottom-btn-bar"
    display="flex"
    flexDirection="row"
    gap="8"
    marginTop="32"
    />

<style id="text-center" 
    textAlign="center"
    />

<style id="text-light" 
    color="{{ white }}"
    />

<style id="text-dark"
    color="{{ gray_900 }}"
    />

<style id="text-large"
    fontSize="18"
    />

    <style id="text-medium" fontSize="16" />

<style id="input-group" 
    marginBottom="8"
    />

<style id="label"
    marginBottom="4"
    />


<style id="bucket-link" 
    display="flex"
    flexDirection="column"
    backgroundColor="{{ gray_900 }}"
    />




{# not found styles #}
<style id="not-found-description"
    fontSize="24"
    color="black"
    marginBottom="24"
    textAlign="center"
    />

{# server error styles #}
<style id="server-error-description"
    fontSize="24"
    color="black"
    marginBottom="24"
    textAlign="center"
    />