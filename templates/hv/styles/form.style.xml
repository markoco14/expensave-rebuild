<style id="form-column"
    display="flex"
    flexDirection="column"
    flexGrow="1"
    paddingHorizontal="8"
    justifyContent="center"
    gap="16"
    />

<style id="input-group"
    marginBottom="16"
    />

<style id="text-field"
    color="{{ gray_900 }}"
    backgroundColor="{{ white }}"
    padding="4"
    borderWidth="1"
    borderColor="{{ gray_900 }}"
    borderRadius="4"
    />

<style id="text-end" textAlign="right"/>

<style id="input"
    backgroundColor="{{ white }}"
    padding="4"
    borderWidth="1"
    borderColor="{{ gray_900 }}"
    borderRadius="4"
    />

<style id="error"
    color="red"
    />

<style id="select-single" 
    display="flex"
    flexDirection="row"
    gap="8"
    />

<style id="option"
    borderWidth="1"
    borderColor="{{ gray_900 }}"
    paddingVertical="6"
    paddingHorizontal="12"
    borderRadius="4"
    >
    <modifier selected="true">
        <style borderColor="{{ green_500 }}" backgroundColor="{{ green_100 }}" />
    </modifier>    
</style>

<style id="submit-button" 
    color="{{ white }}"
    backgroundColor="{{ gray_600 }}"
    padding="8"
    display="flex"
    flexDirection="row"
    justifyContent="center"
    width="100%"
    />

<style id="form-actions"
    position="absolute"
    bottom="156"
    left="0"
    display="flex"
    flexDirection="row"
    width="100%"
    justifyContent="center"
    gap="8"
    />

<style id="form-action"
    {# paddingHorizontal="24" #}
    padding="16"
    borderWidth="1"
    borderRadius="100%"
    />

<style id="form-action--primary"
    borderColor="{{ green_600 }}"
    backgroundColor="{{ green_200 }}"
    />

<style id="form-action--secondary"
    borderColor="{{ gray_600 }}"
    backgroundColor="{{ gray_200 }}"
    />

<style id="form-action--placeholder"
    borderWidth="0"
    />