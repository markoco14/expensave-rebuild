<view id="form-fields" xmlns="https://hyperview.org/hyperview" style="content content--top">
    {% if saved == True %}
        <behavior trigger="load" action="dispatch-event" event-name="purchase-added" />
        <behavior trigger="load" action="reload" href="/hv/purchases/{{ purchase.purchase_id }}"/>
    {% endif %}
    <text style="text-dark">Amount</text>
    <text-field 
        name="amount" 
        placeholder="Amount" 
        keyboard-type="number-pad"
        style="text-field" 
        value="{{ purchase.amount }}"
        />
    <text style="error">{{ errors.get("amount", "") if errors else ''}}</text>
</view>