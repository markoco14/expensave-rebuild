{% extends "hv/layout.xml" %}

{% block header %}
<text style="heading text-dark">Edit Purchase</text>
{% endblock header%}

{% block content %}
<form id="purchase-form" style="container">
    <behavior trigger="refresh" action="reload"/>
    
    {% include "hv/purchases/_form_fields.xml" %}

    <view style="form-actions">

        <view style="form-actions__column form-actions__column--left">
            <view 
                style="btn btn-secondary form-action form-action--secondary"
                >
                <behavior trigger="press" action="reload" href="/hv/purchases/{{ purchase.purchase_id }}"/>
                {% include "hv/svg/cancel.xml" %}
            </view>
        </view>

        <view style="form-actions__column form-actions__column--center">
            <view 
                verb="post"
                href="/hv/purchases/{{ purchase.purchase_id }}/edit"
                target="form-fields"
                action="replace-inner"
                style="btn btn-primary form-action form-action--primary"
                >
                {% include "hv/svg/checkmark-primary.xml" %}
            </view>
        </view>
        
        <view style="form-actions__column form-actions__column--right">
            <view style="form-action form-action--delete">
                <behavior 
                    trigger="press" 
                    action="append" 
                    target="purchase-info"
                    href="/hv/purchases/{{ purchase.purchase_id }}/delete" 
                    verb="post"
                    />
                {% include "hv/svg/delete.xml" %}
            </view>
        </view>

    </view>
</form>

{% endblock content%}