<form id="purchase-form" xmlns="https://hyperview.org/hyperview" style="form-column">
    
    {% if saved == True %}
    <behavior trigger="load" action="dispatch-event" event-name="purchase-added" />
    <behavior trigger="load" action="back" />
    {% endif %}
    <view>
        <text style="text-dark text-large">How much did you spend</text>
    </view>
    <keypad-input xmlns="https://mysavemoneylife.com/hyperview/keypad">
        <keypad-display style="keypad-display">
            <keypad-display-text style="keypad-display-text" />
        </keypad-display>
        <keypad-view style="keypad-numbers">
            {% for i in range(1, 10) %}
                <keypad-number-btn display_number="{{ i }}" style="keypad-button">
                    <text xmlns="https://hyperview.org/hyperview" style="keypad-button-text">{{ i }}</text>
                </keypad-number-btn>
            {% endfor %}
            <view xmlns="https://hyperview.org/hyperview" style="keypad-button-empty" />
            <keypad-number-btn display_number="0" style="keypad-button" text-style="keypad-button-text">
                <text xmlns="https://hyperview.org/hyperview" style="keypad-button-text">0</text>
            </keypad-number-btn>
            <keypad-delete-btn style="keypad-button" text-style="keypad-button-text">
                <text xmlns="https://hyperview.org/hyperview" style="keypad-button-text">X</text>
            </keypad-delete-btn>
        </keypad-view>
    </keypad-input>
    
    <view style="form-actions">
        <view 
            action="back"
            style="btn btn-secondary"
            >
            <text style="text-dark text-large text-center">Cancel</text>
        </view>

        <view verb="post" href="/hv/today" action="replace" target="purchase-form" style="btn btn-primary">
            <text style="btn-primary-text">Save</text>
        </view>
    </view>
    
</form>
