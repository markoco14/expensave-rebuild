{% extends "hv/layout.xml" %}

{% block header %}
<text style="heading text-dark text-center">Purchase Info</text>
{% endblock header%}

{% block content %}
<view style="container">

    <view style="content content--top purchase-fields">

        <view style="purchase-field">
            <text style="purchase-label">Amount</text>
            <text style="purchase-detail">${{ purchase.amount }} {{ purchase.currency }}</text>
        </view>

        <view style="purchase-field">
            <text style="purchase-label">Time</text>
            <text style="purchase-detail">{{ purchase.purchased_at.strftime("%B %d at %H:%M:%S") }}</text>
        </view>

        <view style="purchase-field">
            <text style="purchase-label">Timezone</text>
            <text style="purchase-detail">{{ purchase.timezone }}</text>
        </view>

    </view>
    <view style="form-actions">

        <view style="form-actions__column form-actions__column--left">
            <view 
                action="back"
                style="form-action form-action--secondary"
                >
                {% include "hv/svg/back.xml" %}
            </view>
        </view>

        <view style="form-actions__column form-actions__column--center">
            <view 
                action="reload" 
                href="/hv/purchases/{{ purchase.purchase_id }}/edit"
                style="form-action form-action--primary"
                >
                {% include "hv/svg/edit.xml" %}
            </view>
        </view>

        <view style="form-actions__column form-actions__column--right" />

    </view>
</view>
{% endblock content %}
